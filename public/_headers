# Keep pages revalidatable and allow Cloudflare to compress text responses.
/*
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Theme artwork keeps stable URLs, so revalidate it after the generic image rule.
/themes/fuyukawa-kagari/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
