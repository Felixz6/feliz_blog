# Keep pages revalidatable and stop Cloudflare's automatic Web Analytics beacon injection.
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/themes/fuyukawa-kagari/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
