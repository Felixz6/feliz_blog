---
import { getCollection, render } from "astro:content";
import { projectMetadata } from "@/core/data/project-metadata";
import BaseLayout from "@/themes/fuyukawa-kagari/layouts/BaseLayout.astro";
import DocumentLayout from "@/themes/fuyukawa-kagari/components/DocumentLayout.astro";

export async function getStaticPaths() {
  const allDocs = await getCollection("projectDocs");
  return allDocs.map((document) => ({
    params: { project: document.data.project, slug: document.data.routeSlug },
    props: {
      document,
      documents: allDocs
        .filter((item) => item.data.project === document.data.project)
        .sort((a, b) => a.data.order - b.data.order)
    }
  }));
}

const { document, documents } = Astro.props;
const { Content, headings } = await render(document);
const project = projectMetadata[document.data.project];
const documentIndex = documents.findIndex((item) => item.id === document.id);
const previousDocument = documents[documentIndex - 1];
const nextDocument = documents[documentIndex + 1];
---

<BaseLayout title={`${document.data.title} | ${project.name}`} description={document.data.description} isArticlePage needsMangaRuntime>
  <DocumentLayout
    kind="project-doc"
    title={document.data.title}
    description={document.data.description}
    eyebrow={`${project.name} / PROJECT DOCS`}
    current={document.data.order}
    total={documents.length}
    headings={headings}
    backHref={project.docsHref}
    backLabel="回到文档目录"
    pagerLabel="项目文档导航"
    previous={previousDocument && {
      href: `${project.docsHref}${previousDocument.data.routeSlug}/`,
      title: previousDocument.data.title
    }}
    next={nextDocument && {
      href: `${project.docsHref}${nextDocument.data.routeSlug}/`,
      title: nextDocument.data.title
    }}
    finishHref={project.href}
    finishLabel="已读完"
    finishTitle="返回项目介绍"
  >
    <Content />
  </DocumentLayout>
</BaseLayout>
