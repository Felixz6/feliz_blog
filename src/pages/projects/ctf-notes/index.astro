---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/themes/fuyukawa-kagari/layouts/BaseLayout.astro";

const notes = (await getCollection("ctfNotes")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="CTF Notes | Feliz" description="Web CTF 常见题型的分析流程与解题笔记。">
  <main class="ctf-notes-index">
    <a class="back-link" href="/projects/"><Icon name="tabler:arrow-left" aria-hidden="true" />回到 Projects</a>
    <header class="ctf-notes-hero">
      <p class="section-kicker">CTF / WEB SECURITY / NOTES</p>
      <h1>CTF Notes<span class="page-title-en">Web 题型笔记</span></h1>
      <p>从快速检查清单到常见漏洞题型，整理成可直接翻阅的分析流程。</p>
      <div class="ctf-notes-count"><strong>{String(notes.length).padStart(2, "0")}</strong><span>篇整理笔记</span></div>
    </header>

    <section class="ctf-note-grid" aria-label="CTF Web 笔记列表">
      {notes.map((note, index) => (
        <a class="ctf-note-card" href={`/projects/ctf-notes/${note.id}/`}>
          <span class="ctf-note-number">{String(index + 1).padStart(2, "0")}</span>
          <span class="ctf-note-card-copy">
            <strong>{note.data.title}</strong>
            <span>{note.data.description}</span>
          </span>
          <Icon name="tabler:arrow-right" aria-hidden="true" />
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .ctf-notes-index { width: min(1100px, calc(100% - 40px)); margin: 112px auto 88px; }
  .back-link { display: inline-flex; align-items: center; gap: 9px; margin-bottom: 30px; color: var(--accent); font-size: .88rem; font-weight: 720; }
  .back-link svg { width: 18px; height: 18px; }
  .ctf-notes-hero { position: relative; display: grid; gap: 14px; padding: 38px 42px; border: 1px solid var(--line); border-top: 3px solid #d990ad; background: rgba(255,255,255,.8); box-shadow: 4px 5px 0 #eaf1f8; }
  .ctf-notes-hero .section-kicker { margin: 0; color: var(--accent); font: 700 .75rem/1.4 ui-monospace, monospace; letter-spacing: .12em; }
  .ctf-notes-hero h1 { margin: 0; color: var(--ink); font-size: clamp(2rem, 5vw, 3.2rem); }
  .ctf-notes-hero h1 span { display: inline-block; margin-left: 14px; color: var(--ink-soft); font-size: .45em; vertical-align: .3em; }
  .ctf-notes-hero > p:not(.section-kicker) { max-width: 700px; margin: 0; color: var(--ink-soft); line-height: 1.8; }
  .ctf-notes-count { position: absolute; top: 35px; right: 40px; display: grid; justify-items: end; gap: 2px; color: var(--ink-soft); }
  .ctf-notes-count strong { color: #95abc3; font: 500 2rem/1 ui-monospace, monospace; }
  .ctf-notes-count span { font-size: .75rem; }
  .ctf-note-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px; margin-top: 26px; }
  .ctf-note-card { display: grid; grid-template-columns: 42px minmax(0,1fr) 20px; align-items: start; gap: 16px; min-height: 132px; padding: 22px; border: 1px solid var(--line); border-radius: 7px; background: rgba(255,255,255,.85); box-shadow: 3px 4px 0 #edf3f8; color: inherit; text-decoration: none; transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease; }
  .ctf-note-card:hover { transform: translateY(-3px); border-color: #e4b1c4; box-shadow: 5px 7px 0 #edf3f8; }
  .ctf-note-number { color: #9cacc1; font: 600 1rem/1.5 ui-monospace, monospace; }
  .ctf-note-card-copy { display: grid; gap: 9px; }
  .ctf-note-card-copy strong { color: var(--ink); font-size: 1.05rem; }
  .ctf-note-card-copy span { color: var(--ink-soft); font-size: .88rem; line-height: 1.7; }
  .ctf-note-card > svg { width: 19px; height: 19px; color: var(--accent); }
  @media (max-width: 680px) {
    .ctf-notes-index { width: min(100% - 28px, 560px); margin-top: 92px; }
    .ctf-notes-hero { padding: 28px 24px; }
    .ctf-notes-hero h1 span { display: block; margin: 5px 0 0; }
    .ctf-notes-count { top: 28px; right: 24px; }
    .ctf-note-grid { grid-template-columns: 1fr; }
  }
</style>
