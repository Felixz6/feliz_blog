---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/themes/fuyukawa-kagari/layouts/BaseLayout.astro";
import DocumentLayout from "@/themes/fuyukawa-kagari/components/DocumentLayout.astro";

export async function getStaticPaths() {
  const notes = (await getCollection("ctfNotes")).sort((a, b) => a.data.order - b.data.order);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const notes = (await getCollection("ctfNotes")).sort((a, b) => a.data.order - b.data.order);
const { note } = Astro.props;
const noteIndex = notes.findIndex((item) => item.id === note.id);
const { Content, headings } = await render(note);
const previousNote = notes[noteIndex - 1];
const nextNote = notes[noteIndex + 1];
---

<BaseLayout title={`${note.data.title} | CTF Notes`} description={note.data.description} isArticlePage needsMangaRuntime>
  <DocumentLayout
    kind="ctf-note"
    title={note.data.title}
    description={note.data.description}
    eyebrow="CTF WEB NOTES"
    current={noteIndex + 1}
    total={notes.length}
    headings={headings}
    backHref="/projects/ctf-notes/"
    backLabel="回到 CTF Notes"
    pagerLabel="笔记导航"
    previous={previousNote && { href: `/projects/ctf-notes/${previousNote.id}/`, title: previousNote.data.title }}
    next={nextNote && { href: `/projects/ctf-notes/${nextNote.id}/`, title: nextNote.data.title }}
    finishHref="/projects/ctf-notes/"
    finishLabel="已读完"
    finishTitle="返回笔记列表"
  >
    <Content />
  </DocumentLayout>
</BaseLayout>
