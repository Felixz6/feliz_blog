---
import { mangaArt, type MangaImage } from "../data/mangaArt";
interface Props {
  image: MangaImage;
  class?: string;
  alt?: string;
  eager?: boolean;
  fetchpriority?: "high" | "low" | "auto";
}
const { image, class: className, alt = "", eager = false, fetchpriority } = Astro.props;
const art = mangaArt(image);
---
<img
  {...art}
  class:list={["manga-art", className]}
  alt={alt}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={fetchpriority}
  draggable="false"
/>
