---
import MangaArt from "./MangaArt.astro";
const pages = [
  { image: "clannad-cover" as const, title: "无论今后发生什么，\n请不要后悔与我相遇。", subtitle: "", credit: "--- CLANNAD", alt: "《CLANNAD》中的樱花与角色插画" },
  { image: "biqigu-cover" as const, title: "温柔正确的人总是难以生存，\n因为这世界既不温柔，也不正确", subtitle: "", credit: "---大老师", alt: "比企谷八幡沉思的插画" },
  { image: "eighty-six-cover" as const, title: "破碎的弹片交织于无尽的花海间，\n我们没有忘记彼此的誓言。", subtitle: "", credit: "---86", alt: "《86》两位角色的场景插画" }
];
---
<section class="memory-album" data-manga-album aria-labelledby="memory-album-title">
  <header class="manga-section-heading">
    <div><p class="section-kicker">FRAGMENTS OF MEMORY</p><h2 id="memory-album-title">藏在时光里的物语</h2></div>
    <div class="album-tabs" role="group" aria-label="选择彩页">
      {pages.map((page, i) => <button type="button" data-album-tab={i} aria-pressed={i === 0 ? "true" : "false"} aria-controls={`memory-page-${i}`} title={page.title}>{String(i + 1).padStart(2, "0")}</button>)}
    </div>
  </header>
  <div class="album-pages">
    {pages.map((page, i) => (
      <figure class="album-page" id={`memory-page-${i}`} data-album-page hidden={i !== 0}>
        <button class="album-page-image-next" type="button" data-album-next aria-label="翻到下一页" title="点击图片翻到下一页">
          <MangaArt image={page.image} alt={page.alt} />
        </button>
        <figcaption>
          {page.subtitle && <span>{page.subtitle}</span>}
          <h3>{page.title}</h3>
          <small class:list={["album-page-credit", page.credit ? "album-page-credit--right" : undefined]}>{page.credit ?? "葉佐乃 · 儚いキミは猛攻をはじめる"}</small>
        </figcaption>
      </figure>
    ))}
    <MangaArt image="festival-pair" class="album-companion" />
  </div>
</section>
