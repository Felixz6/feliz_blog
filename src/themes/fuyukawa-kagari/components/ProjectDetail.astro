---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "@/lib/site";

interface Props {
  title: string;
  kicker: string;
  description: string;
  tags: string[];
}

const { title, kicker, description, tags } = Astro.props;
---

<BaseLayout title={`${title} | Projects | ${site.name}`} description={description}>
  <main class="project-detail-shell">
    <a class="project-detail-back" href="/projects/">
      <Icon name="tabler:arrow-left" aria-hidden="true" />回到 Projects
    </a>
    <header class="project-detail-hero">
      <p class="project-detail-kicker">{kicker}</p>
      <h1>{title}</h1>
      <p class="project-detail-intro">{description}</p>
      <div class="project-detail-tags" aria-label="Project tags">
        {tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="project-detail-content"><slot /></div>
    <a class="project-detail-return" href="/projects/">
      <span>返回项目列表</span><Icon name="tabler:arrow-right" aria-hidden="true" />
    </a>
  </main>
</BaseLayout>

<style>
  .project-detail-shell { width: min(1100px, calc(100% - 40px)); margin: 112px auto 88px; }
  .project-detail-back { display: inline-flex; align-items: center; gap: 9px; margin-bottom: 24px; color: var(--accent); font-size: .88rem; font-weight: 720; text-decoration: none; }
  .project-detail-back svg, .project-detail-return svg { width: 18px; height: 18px; }
  .project-detail-hero { display: grid; gap: 14px; padding: 38px 42px; border: 1px solid var(--line); border-top: 3px solid #8dc3df; background: rgba(255,255,255,.86); box-shadow: 4px 5px 0 #eaf1f8; }
  .project-detail-kicker { margin: 0; color: var(--accent); font: 700 .75rem/1.4 ui-monospace, monospace; letter-spacing: .12em; }
  .project-detail-hero h1 { margin: 0; color: var(--ink); font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.2; }
  .project-detail-intro { max-width: 780px; margin: 0; color: var(--ink-soft); line-height: 1.85; }
  .project-detail-tags { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 3px; }
  .project-detail-tags span { padding: 6px 10px; border: 1px solid var(--line); border-radius: 5px; background: #f3f8fc; color: var(--ink-soft); font-size: .8rem; font-weight: 700; }
  .project-detail-content { display: grid; gap: 18px; margin-top: 24px; }
  .project-detail-content :global(.project-detail-section) { padding: 28px 32px; border: 1px solid var(--line); border-radius: 7px; background: rgba(255,255,255,.82); box-shadow: 3px 4px 0 #edf3f8; }
  .project-detail-content :global(.project-detail-section h2) { margin: 0 0 14px; color: var(--ink); font-size: 1.2rem; }
  .project-detail-content :global(.project-detail-section p) { margin: 0; color: var(--ink-soft); line-height: 1.85; }
  .project-detail-content :global(.project-detail-doc-link) { display: inline-flex; align-items: center; width: fit-content; margin-top: 16px; padding: 12px 16px; border: 1px solid #dce7f1; border-radius: 6px; background: #eff6fb; color: var(--accent); font-weight: 760; text-decoration: none; }
  .project-detail-content :global(.project-detail-doc-link:hover) { color: var(--ink); border-color: #c4d8e8; }
  .project-detail-content :global(.project-detail-repo-card) { display: flex; align-items: center; gap: 18px; color: inherit; text-decoration: none; transition: border-color .18s ease, background-color .18s ease, transform .18s ease; }
  .project-detail-content :global(.project-detail-repo-card:hover) { border-color: #b9d4e7; background: #f8fbfe; transform: translateY(-2px); }
  .project-detail-content :global(.project-detail-repo-card:focus-visible) { outline: 3px solid #8dc3df; outline-offset: 3px; }
  .project-detail-content :global(.project-detail-repo-mark) { display: grid; flex: 0 0 58px; width: 58px; height: 58px; place-items: center; border: 1px solid #dce7f1; border-radius: 7px; background: #eff6fb; color: var(--accent); }
  .project-detail-content :global(.project-detail-repo-mark svg) { width: 27px; height: 27px; }
  .project-detail-content :global(.project-detail-repo-copy) { display: grid; flex: 1; gap: 5px; }
  .project-detail-content :global(.project-detail-repo-kicker) { color: var(--accent); font: 700 .72rem/1.4 ui-monospace, monospace; letter-spacing: .1em; }
  .project-detail-content :global(.project-detail-repo-copy strong) { color: var(--ink); font-size: 1.2rem; }
  .project-detail-content :global(.project-detail-repo-description) { color: var(--ink-soft); line-height: 1.7; }
  .project-detail-content :global(.project-detail-repo-arrow) { flex: 0 0 20px; width: 20px; height: 20px; color: var(--accent); }
  .project-detail-content :global(.project-detail-grid) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .project-detail-content :global(.project-detail-tile) { display: grid; align-content: start; gap: 9px; min-height: 132px; padding: 22px; border: 1px solid var(--line); border-radius: 7px; background: rgba(255,255,255,.82); box-shadow: 3px 4px 0 #edf3f8; }
  .project-detail-content :global(.project-detail-tile strong) { color: var(--ink); }
  .project-detail-content :global(.project-detail-tile p) { color: var(--ink-soft); font-size: .9rem; line-height: 1.75; }
  .project-detail-content :global(pre) { overflow-x: auto; margin: 16px 0 0; padding: 18px 20px; border: 1px solid #dce7f1; border-radius: 6px; background: #f4f8fc; color: var(--ink); font: .88rem/1.8 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .project-detail-return { display: inline-flex; align-items: center; gap: 12px; margin-top: 24px; padding: 14px 18px; border: 1px solid #dce7f1; border-radius: 6px; background: #eff6fb; color: var(--accent); font-weight: 760; text-decoration: none; }
  .project-detail-return:hover, .project-detail-back:hover { color: var(--ink); }
  @media (max-width: 760px) {
    .project-detail-shell { width: min(100% - 28px, 560px); margin-top: 92px; }
    .project-detail-hero { padding: 28px 24px; }
    .project-detail-content :global(.project-detail-section) { padding: 24px; }
    .project-detail-content :global(.project-detail-grid) { grid-template-columns: 1fr; }
    .project-detail-content :global(.project-detail-repo-card) { gap: 14px; }
    .project-detail-content :global(.project-detail-repo-mark) { flex-basis: 48px; width: 48px; height: 48px; }
    .project-detail-content :global(.project-detail-repo-copy strong) { font-size: 1.05rem; }
  }
</style>
