<script>
  import { mountMangaScene, mountChapterRail, mountAlbum, mountArchive, mountArticleToc } from "../lib/manga-runtime.mjs";
  let cleanup: (() => void)[] = [];
  let mountedRoots: HTMLElement[] = [];
  const dispose = () => {
    cleanup.splice(0).forEach((stop) => stop());
    mountedRoots = [];
  };
  const start = () => {
    if (!document.body.hasAttribute("data-fuyukawa")) {
      dispose();
      return;
    }
    const targets = [
      ["[data-manga-scene]", mountMangaScene],
      ["[data-manga-rail]", mountChapterRail],
      ["[data-manga-album]", mountAlbum],
      ["[data-manga-archive]", mountArchive],
      ["[data-article-shell]", mountArticleToc]
    ] as const;
    const rootsByTarget = targets.map(([selector, mount]) => ({
      mount,
      roots: [...document.querySelectorAll<HTMLElement>(selector)]
    }));
    const roots = rootsByTarget.flatMap(({ roots }) => roots);
    if (roots.length === mountedRoots.length && roots.every((root, index) => root === mountedRoots[index])) return;
    dispose();
    rootsByTarget.forEach(({ mount, roots }) => roots.forEach((root) => cleanup.push(mount(root))));
    mountedRoots = roots;
  };
  document.addEventListener("astro:page-load", start);
  document.addEventListener("astro:before-swap", dispose);
  start();
</script>
