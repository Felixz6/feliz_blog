---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "@/core/content/blog";
import { getCoverSources } from "@/core/content/coverSources";
import { categoryLabel } from "@/lib/site";
import { Icon } from "astro-icon/components";
import { kagariAssets } from "../assets";
import MangaArt from "../components/MangaArt.astro";
import { site } from "@/lib/site";

const posts = (await getPublishedPosts())
  .map((post) => {
    const rawText = post.body
      .replace(/```[\s\S]*?```/g, "")
      .replace(/<[^>]+>/g, "")
      .replace(/[#>*_\-[\]()`~]/g, "")
      .trim();
    const cjk = rawText.match(/[\u4e00-\u9fff]/g)?.length ?? 0;
    const words = rawText.replace(/[\u4e00-\u9fff]/g, " ").match(/[A-Za-z0-9]+/g)?.length ?? 0;
    return {
      ...post,
      wordCount: cjk + words,
      updatedAt: post.data.updatedDate ?? post.data.pubDate,
      hasUpdatedDate: Boolean(post.data.updatedDate),
      cover: post.data.cover ?? kagariAssets.heroWallpaper
    };
  });

const formatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
});

const getBlogPostHref = (id: string) => `/blog/${id}/`;
const getBlogTagHref = (tag: string) => `/blog/?q=${encodeURIComponent(tag)}`;
const getBlogCategoryHref = (category: string) => `/blog/?category=${encodeURIComponent(category)}`;
const blogCoverSizes = [
  "(max-width: 480px) calc(100vw - 84px)",
  "(max-width: 561px) 160px",
  "(max-width: 760px) calc(35.14vw - 37px)",
  "(max-width: 773px) 160px",
  "(max-width: 1224px) calc(35.14vw - 111.7px)",
  "318px"
].join(", ");
---

<BaseLayout title={`Blog | ${site.name}`} description={site.description} needsMangaRuntime>
  <div class="manga-archive" data-manga-archive>
  <section class="page-title blog-hero-card">
    <div class="blog-title-copy">
      <p class="section-kicker">01 / The notebook</p>
      <h1>笔记存档<span class="page-title-en">Blog</span></h1>
      <p>一些认真折腾的记录，<br />一些舍不得忘掉的瞬间。</p>
      <span class="manga-handwritten">Dear ordinary days.</span>
    </div>
    <div class="blog-title-art" aria-hidden="true">
      <MangaArt image="reading-strip" class="blog-opening-panel" eager />
      <MangaArt image="kagari-tea" class="blog-opening-character" eager />
      <span class="manga-page-stamp">NOTE<br />BOOK</span>
    </div>
  </section>

  <section class="blog-search-card" data-pagefind-ignore>
    <div class="blog-search-heading">
      <Icon name="tabler:search" aria-hidden="true" />
      <div>
        <p class="section-kicker">Search</p>
        <h2>翻找笔记</h2>
      </div>
    </div>
    <label class="blog-search-box">
      <span>关键词</span>
      <input type="search" data-blog-search placeholder="输入CTF、RISC-V、Steam ..." autocomplete="off" />
    </label>
    <div class="blog-search-meta" data-blog-search-meta hidden>
      <p data-blog-search-summary aria-live="polite"></p>
      <button type="button" data-blog-search-more hidden>查看更多</button>
    </div>
    <p class="blog-search-error" data-blog-search-error role="status" hidden></p>
    <div class="blog-search-results" data-blog-search-results aria-live="polite"></div>
  </section>

  <div class="archive-shelf">
    <aside class="archive-spine">
      <nav class="archive-tabs" aria-label="笔记分类">
        <button type="button" data-archive-category="all" aria-pressed="true"><Icon name="tabler:book-2" aria-hidden="true" />全部</button>
        {Object.entries(categoryLabel).map(([key, label]) => (
          <button type="button" data-archive-category={key} aria-pressed="false">{label}</button>
        ))}
      </nav>
      <p data-archive-count aria-live="polite">{posts.length} 篇笔记</p>
      <MangaArt image="kagari-thinking" class="archive-companion" />
    </aside>
  <section class="blog-timeline" aria-label="Blog timeline">
    {
      posts.map((post) => (
        <article class="blog-timeline-item" data-entry-category={post.data.category}>
          <div class="timeline-date">
            <time datetime={post.updatedAt.toISOString()}>{formatter.format(post.updatedAt)}</time>
            <span>{post.hasUpdatedDate ? "updated" : "published"}</span>
          </div>
          <div class="post-row blog-post-row">
            <a class="post-cover-frame" href={getBlogPostHref(post.id)} aria-label={`阅读：${post.data.title}`}>
              <img src={post.cover} {...getCoverSources(post.cover, blogCoverSizes)} alt="" loading="lazy" decoding="async" />
            </a>
            <div class="blog-post-copy">
              <div class="meta-row">
                <a class="blog-category-filter-link" href={getBlogCategoryHref(post.data.category)}>{categoryLabel[post.data.category]}</a>
                <time datetime={post.data.pubDate.toISOString()}>发布 {formatter.format(post.data.pubDate)}</time>
                {post.hasUpdatedDate && <time datetime={post.updatedAt.toISOString()}>更新 {formatter.format(post.updatedAt)}</time>}
                <span>{post.wordCount.toLocaleString("zh-CN")} 字</span>
              </div>
              <h2><a class="blog-post-title-link" href={getBlogPostHref(post.id)}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <div class="tag-row">
                {post.data.tags.map((tag) => <a class="blog-tag-link" href={getBlogTagHref(tag)}>#{tag}</a>)}
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </section>
  </div>

  </div>

  <script is:inline data-astro-rerun>
    (() => {
    window.__fuyukawaSearchCleanup?.();
    const searchInput = document.querySelector("[data-blog-search]");
    const searchResults = document.querySelector("[data-blog-search-results]");
    const searchMeta = document.querySelector("[data-blog-search-meta]");
    const searchSummary = document.querySelector("[data-blog-search-summary]");
    const loadMoreButton = document.querySelector("[data-blog-search-more]");
    const loadMoreError = document.querySelector("[data-blog-search-error]");
    let pagefindReady;
    let currentMatches = [];
    let displayedCount = 0;
    let loadingMore = false;
    const pageSize = 5;

    const escapeHtml = (value) =>
      value.replace(/[&<>"']/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      })[char] ?? char);

    const loadPagefind = async () => {
      if (!pagefindReady) {
        const importRuntime = new Function("path", "return import(path)");
        const pending = importRuntime("/pagefind/pagefind.js").then(async (pagefind) => {
          await pagefind.options({
            excerptLength: 18
          });
          return pagefind;
        });
        pagefindReady = pending;
      }
      const pending = pagefindReady;
      try {
        return await pending;
      } catch (error) {
        if (pagefindReady === pending) pagefindReady = undefined;
        throw error;
      }
    };

    const renderSearchState = (message) => {
      if (!searchResults) return;
      searchResults.innerHTML = `<p class="blog-search-empty">${message}</p>`;
    };

    const updateQueryInUrl = (query) => {
      const url = new URL(window.location.href);
      if (query) url.searchParams.set("q", query);
      else url.searchParams.delete("q");
      const next = `${url.pathname}${url.search}${url.hash}`;
      if (next !== `${window.location.pathname}${window.location.search}${window.location.hash}`) {
        window.history.replaceState(window.history.state, "", next);
      }
    };

    const fallbackLocalSearch = (query) => {
      const cards = [...document.querySelectorAll(".blog-post-row")];
      const lowerQuery = query.toLowerCase();
      return cards
        .map((card) => ({
          url: card.querySelector(".blog-post-title-link")?.getAttribute("href")
            ?? card.querySelector(".post-cover-frame")?.getAttribute("href")
            ?? "#",
          title: card.querySelector("h2")?.textContent?.trim() ?? "Untitled",
          excerpt: card.querySelector("p")?.textContent?.trim() ?? "",
          text: card.textContent?.toLowerCase() ?? ""
        }))
        .filter((item) => item.text.includes(lowerQuery))
        .map((item) => ({ url: item.url, meta: { title: item.title }, excerpt: escapeHtml(item.excerpt) }));
    };

    const showMoreResults = async (version) => {
      if (loadingMore || version !== searchVersion || !currentMatches.length) return;
      const batch = currentMatches.slice(displayedCount, displayedCount + pageSize);
      if (!batch.length) return;
      loadingMore = true;
      if (loadMoreError) {
        loadMoreError.hidden = true;
        loadMoreError.textContent = "";
      }
      if (loadMoreButton) loadMoreButton.disabled = true;
      try {
        const data = await Promise.all(batch.map((match) =>
          typeof match.data === "function" ? match.data() : match
        ));
        if (version !== searchVersion || !searchInput?.isConnected) return;
        if (searchResults) {
          searchResults.innerHTML += data.map((item) => `
            <a class="blog-search-result" href="${escapeHtml(item.url || "#")}">
              <strong>${escapeHtml(item.meta?.title || "Untitled")}</strong>
              <span>${item.excerpt || ""}</span>
            </a>
          `).join("");
        }
        displayedCount += data.length;
        if (searchSummary) searchSummary.textContent = `共找到 ${currentMatches.length} 篇笔记，已显示 ${displayedCount} 篇`;
        if (loadMoreButton) {
          const remaining = currentMatches.length - displayedCount;
          loadMoreButton.hidden = remaining <= 0;
          loadMoreButton.textContent = `查看更多（还有 ${remaining} 篇）`;
        }
      } catch {
        if (version !== searchVersion || !searchInput?.isConnected) return;
        if (loadMoreError) {
          loadMoreError.textContent = "加载失败，请重试。";
          loadMoreError.hidden = false;
        }
        if (loadMoreButton) {
          loadMoreButton.hidden = false;
          loadMoreButton.textContent = `重试查看更多（还有 ${currentMatches.length - displayedCount} 篇）`;
        }
      } finally {
        if (version === searchVersion) {
          loadingMore = false;
          if (loadMoreButton) loadMoreButton.disabled = false;
        }
      }
    };

    const displayMatches = async (matches, version) => {
      currentMatches = matches;
      displayedCount = 0;
      loadingMore = false;
      if (searchResults) searchResults.innerHTML = "";
      if (loadMoreError) {
        loadMoreError.hidden = true;
        loadMoreError.textContent = "";
      }
      if (loadMoreButton) {
        loadMoreButton.hidden = true;
        loadMoreButton.disabled = false;
        loadMoreButton.textContent = "查看更多";
      }
      if (!matches.length) {
        if (searchSummary) searchSummary.textContent = "共找到 0 篇笔记";
        renderSearchState("没有找到相关笔记。");
        return;
      }
      await showMoreResults(version);
    };

    let searchTimer = 0;
    let searchVersion = 0;
    const onSearch = (syncUrl = true) => {
      const version = ++searchVersion;
      window.clearTimeout(searchTimer);
      const query = searchInput.value.trim();
      currentMatches = [];
      displayedCount = 0;
      loadingMore = false;
      if (loadMoreError) {
        loadMoreError.hidden = true;
        loadMoreError.textContent = "";
      }
      if (searchMeta) searchMeta.hidden = !query;
      if (syncUrl) updateQueryInUrl(query);
      if (loadMoreButton) {
        loadMoreButton.hidden = true;
        loadMoreButton.disabled = false;
        loadMoreButton.textContent = "查看更多";
      }
      if (!query) {
        if (searchResults) searchResults.innerHTML = "";
        if (searchSummary) searchSummary.textContent = "";
        return;
      }

      searchTimer = window.setTimeout(async () => {
        if (searchSummary) searchSummary.textContent = "正在查找...";
        renderSearchState("正在翻页...");
        try {
          const pagefind = await loadPagefind();
          const search = await pagefind.search(query);
          if (version !== searchVersion || !searchInput?.isConnected) return;
          await displayMatches(search.results, version);
        } catch {
          if (version !== searchVersion || !searchInput?.isConnected) return;
          await displayMatches(fallbackLocalSearch(query), version);
        }
      }, 180);
    };
    const onInput = () => onSearch(true);
    const onLoadMore = () => showMoreResults(searchVersion);
    const restoreQueryFromUrl = () => {
      const query = new URL(window.location.href).searchParams.get("q") ?? "";
      if (searchInput && searchInput.value !== query) {
        searchInput.value = query;
        onSearch(false);
      }
    };
    searchInput?.addEventListener("input", onInput);
    loadMoreButton?.addEventListener("click", onLoadMore);
    window.addEventListener("popstate", restoreQueryFromUrl);
    const initialQuery = new URL(window.location.href).searchParams.get("q") ?? "";
    if (searchInput) {
      searchInput.value = initialQuery;
      if (initialQuery) onSearch(false);
    }
    const cleanup = () => {
      ++searchVersion;
      window.clearTimeout(searchTimer);
      searchInput?.removeEventListener("input", onInput);
      loadMoreButton?.removeEventListener("click", onLoadMore);
      window.removeEventListener("popstate", restoreQueryFromUrl);
      document.removeEventListener("astro:before-swap", cleanup);
    };
    window.__fuyukawaSearchCleanup = cleanup;
    document.addEventListener("astro:before-swap", cleanup, { once: true });
    })();
  </script>
</BaseLayout>
