---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "@/core/content/blog";
import { getCoverSources } from "@/core/content/coverSources";
import { categoryLabel } from "@/lib/site";
import { Icon } from "astro-icon/components";
import { kagariAssets } from "../assets";
import MangaArt from "../components/MangaArt.astro";
import { site } from "@/lib/site";

const posts = (await getPublishedPosts())
  .map((post) => {
    const rawText = (post.body ?? "")
      .replace(/```[\s\S]*?```/g, "")
      .replace(/<[^>]+>/g, "")
      .replace(/[#>*_\-[\]()`~]/g, "")
      .trim();
    const cjk = rawText.match(/[\u4e00-\u9fff]/g)?.length ?? 0;
    const words = rawText.replace(/[\u4e00-\u9fff]/g, " ").match(/[A-Za-z0-9]+/g)?.length ?? 0;
    return {
      ...post,
      wordCount: cjk + words,
      updatedAt: post.data.updatedDate ?? post.data.pubDate,
      hasUpdatedDate: Boolean(post.data.updatedDate),
      cover: post.data.cover ?? kagariAssets.heroWallpaper
    };
  });

const formatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
});

const getBlogPostHref = (id: string) => `/blog/${id}/`;
const getBlogTagHref = (tag: string) => `/blog/?q=${encodeURIComponent(tag)}`;
const getBlogCategoryHref = (category: string) => `/blog/?category=${encodeURIComponent(category)}`;
const blogCoverSizes = [
  "(max-width: 480px) calc(100vw - 84px)",
  "(max-width: 561px) 160px",
  "(max-width: 760px) calc(35.14vw - 37px)",
  "(max-width: 773px) 160px",
  "(max-width: 1224px) calc(35.14vw - 111.7px)",
  "318px"
].join(", ");
---

<BaseLayout title={`Blog | ${site.name}`} description={site.description} needsMangaRuntime>
  <div class="manga-archive" data-manga-archive>
  <section class="page-title blog-hero-card">
    <div class="blog-title-copy">
      <p class="section-kicker">01 / The notebook</p>
      <h1>笔记存档<span class="page-title-en">Blog</span></h1>
      <p>一些认真折腾的记录，<br />一些舍不得忘掉的瞬间。</p>
      <span class="manga-handwritten">Dear ordinary days.</span>
    </div>
    <div class="blog-title-art" aria-hidden="true">
      <MangaArt image="reading-strip" class="blog-opening-panel" eager />
      <MangaArt image="kagari-tea" class="blog-opening-character" eager />
      <span class="manga-page-stamp">NOTE<br />BOOK</span>
    </div>
  </section>

  <section class="blog-search-card" data-pagefind-ignore>
    <div class="blog-search-heading">
      <Icon name="tabler:search" aria-hidden="true" />
      <div>
        <p class="section-kicker">Search</p>
        <h2>翻找笔记</h2>
      </div>
    </div>
    <label class="blog-search-box">
      <span>关键词</span>
      <input type="search" data-blog-search placeholder="输入CTF、RISC-V、Steam ..." autocomplete="off" />
    </label>
    <div class="blog-search-meta" data-blog-search-meta hidden>
      <p data-blog-search-summary aria-live="polite"></p>
      <button type="button" data-blog-search-more hidden>查看更多</button>
    </div>
    <p class="blog-search-error" data-blog-search-error role="status" hidden></p>
    <div class="blog-search-results" data-blog-search-results aria-live="polite"></div>
  </section>

  <div class="archive-shelf">
    <aside class="archive-spine">
      <nav class="archive-tabs" aria-label="笔记分类">
        <button type="button" data-archive-category="all" aria-pressed="true"><Icon name="tabler:book-2" aria-hidden="true" />全部</button>
        {Object.entries(categoryLabel).map(([key, label]) => (
          <button type="button" data-archive-category={key} aria-pressed="false">{label}</button>
        ))}
      </nav>
      <p data-archive-count aria-live="polite">{posts.length} 篇笔记</p>
      <MangaArt image="kagari-thinking" class="archive-companion" />
    </aside>
  <section class="blog-timeline" aria-label="Blog timeline">
    {
      posts.map((post) => (
        <article class="blog-timeline-item" data-entry-category={post.data.category}>
          <div class="timeline-date">
            <time datetime={post.updatedAt.toISOString()}>{formatter.format(post.updatedAt)}</time>
            <span>{post.hasUpdatedDate ? "updated" : "published"}</span>
          </div>
          <div class="post-row blog-post-row">
            <a class="post-cover-frame" href={getBlogPostHref(post.id)} aria-label={`阅读：${post.data.title}`}>
              <img src={post.cover} {...getCoverSources(post.cover, blogCoverSizes)} alt="" loading="lazy" decoding="async" />
            </a>
            <div class="blog-post-copy">
              <div class="meta-row">
                <a class="blog-category-filter-link" href={getBlogCategoryHref(post.data.category)}>{categoryLabel[post.data.category]}</a>
                <time datetime={post.data.pubDate.toISOString()}>发布 {formatter.format(post.data.pubDate)}</time>
                {post.hasUpdatedDate && <time datetime={post.updatedAt.toISOString()}>更新 {formatter.format(post.updatedAt)}</time>}
                <span>{post.wordCount.toLocaleString("zh-CN")} 字</span>
              </div>
              <h2><a class="blog-post-title-link" href={getBlogPostHref(post.id)}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              <div class="tag-row">
                {post.data.tags.map((tag) => <a class="blog-tag-link" href={getBlogTagHref(tag)}>#{tag}</a>)}
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </section>
  </div>

  </div>

  <script>
    import { mountBlogSearch } from "../lib/blog-search.mjs";

    let cleanup = () => {};
    const start = () => { cleanup = mountBlogSearch(); };
    const dispose = () => { cleanup(); };
    document.addEventListener("astro:page-load", start);
    document.addEventListener("astro:before-swap", dispose);
    start();
  </script>
</BaseLayout>
