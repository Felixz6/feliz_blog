---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { kagariAsset, kagariAssets } from "../assets";
import MangaArt from "../components/MangaArt.astro";
import MemoryAlbum from "../components/MemoryAlbum.astro";
import {
  animeFavorites,
  currentSignals,
  profileIdentity,
  profileStatus,
  profileTech
} from "@/core/data/profile";
import { site } from "@/lib/site";

const statusItems = profileStatus;
const bioBreakBefore = "立於";
const bioBreakIndex = profileIdentity.bio.indexOf(bioBreakBefore);
const bioFirstLine = bioBreakIndex >= 0
  ? profileIdentity.bio.slice(0, bioBreakIndex).trimEnd()
  : profileIdentity.bio;
const bioSecondLine = bioBreakIndex >= 0
  ? profileIdentity.bio.slice(bioBreakIndex)
  : "";
const techPresentation = {
  "web-security": { icon: "tabler:shield-lock", tone: "blue" },
  ctf: { icon: "tabler:flag-3", tone: "pink" },
  linux: { icon: "simple-icons:linux", tone: "ink" },
  git: { icon: "simple-icons:git", tone: "mint" },
  "open-source": { icon: "simple-icons:github", tone: "lavender" },
  ai: { icon: "tabler:sparkles", tone: "pink" }
} as const;
const techStack = profileTech.map((tech) => ({ ...tech, ...techPresentation[tech.key] }));
const animeShelf = animeFavorites.map((item) => ({
  ...item,
  image: kagariAsset(`about/${item.key}.webp`),
  image320: kagariAsset(`about/responsive/${item.key}-320.webp`),
  image640: kagariAsset(`about/responsive/${item.key}-640.webp`)
}));
const nowDoing = currentSignals;
---

<BaseLayout title={`About | ${site.name}`} description={profileIdentity.bio}>
  <section class="about-profile-shell" aria-labelledby="about-title">
    <aside class="about-sidebar" aria-label="Profile card">
      <div class="about-avatar-card">
        <span class="about-tape about-tape--left" aria-hidden="true"></span>
        <img src={kagariAssets.profile} alt={`${profileIdentity.displayName} avatar`} width="220" height="220" />
      </div>

      <div class="about-id-card">
        <p class="about-kicker">Behind the notebook</p>
        <h1 id="about-title">{profileIdentity.displayName}</h1>
        <p class="about-handle">{profileIdentity.handle} · {profileIdentity.siteName}</p>
        <p class="about-bio">{bioFirstLine}{bioSecondLine && <br />}{bioSecondLine}</p>

        <div class="about-link-row" aria-label="profile links">
          {profileIdentity.github.startsWith("https://") && <a href={profileIdentity.github} target="_blank" rel="noreferrer">
            <Icon name="simple-icons:github" aria-hidden="true" />
            GitHub
          </a>}
          {profileIdentity.bilibili.startsWith("https://") && <a href={profileIdentity.bilibili} target="_blank" rel="noreferrer">
            <Icon name="simple-icons:bilibili" aria-hidden="true" />
            Bilibili
          </a>}
        </div>
      </div>

      <div class="about-status-card">
        <p class="about-mini-title">Now status</p>
        <ul>
          {statusItems.map((item) => (
            <li>
              <Icon name="tabler:pin" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <MangaArt image="kagari-tea" class="about-side-character" />
    </aside>

    <section class="about-readme" aria-label={`${site.name} profile`}>
      <div class="about-readme-hero">
        <div>
          <p class="section-kicker">04 / Dear reader</p>
          <h2>很高兴，在这里遇见你</h2>
          <p>
            音無結弦の時 躍動天使の心 <br />
            立於浮華の世 奏響天籁の音
          </p>
        </div>
        <MangaArt image="letter-page" class="about-letter-art" eager />
      </div>

      <nav class="about-bookmarks" aria-label="个人手帐章节">
        <a href="#memory-album-title"><Icon name="tabler:heart" aria-hidden="true" />片刻</a>
        <a href="#tech-line-title"><Icon name="tabler:code" aria-hidden="true" />技术</a>
        <a href="#anime-shelf-title"><Icon name="tabler:movie" aria-hidden="true" />番剧</a>
        <a href="#now-doing-title"><Icon name="tabler:flower" aria-hidden="true" />近况</a>
      </nav>
      <MemoryAlbum />

      <section class="about-section" aria-labelledby="tech-line-title">
        <div class="about-section-heading">
          <Icon name="tabler:terminal-2" aria-hidden="true" />
          <div>
            <p>Tech line</p>
            <h2 id="tech-line-title">技术栈</h2>
          </div>
        </div>

        <div class="about-tech-grid">
          {techStack.map((tech) => (
            <article class={`about-tech-card about-tech-card--${tech.tone}`}>
              <span class="about-tech-icon" aria-hidden="true">
                <Icon name={tech.icon} />
              </span>
              <div>
                <h3>{tech.name}</h3>
                <p>{tech.note}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section" aria-labelledby="anime-shelf-title">
        <div class="about-section-heading">
          <Icon name="tabler:movie" aria-hidden="true" />
          <div>
            <p>Anime shelf</p>
            <h2 id="anime-shelf-title">喜欢看的番剧</h2>
          </div>
        </div>

        <div class="about-media-grid about-media-grid--anime">
          {animeShelf.length === 0 && <p class="about-empty-state">喜欢的作品待补充。</p>}
          {animeShelf.map((item) => (
            <article class="about-media-card">
              <picture>
                <source
                  media="(max-width: 760px) and (min-resolution: 2dppx)"
                  srcset={`${item.image640} 640w, ${item.image} 900w`}
                  sizes="calc((100vw - 70px) / 2)"
                />
                <img
                  src={item.image}
                  srcset={`${item.image320} 320w, ${item.image640} 640w, ${item.image} 900w`}
                  sizes="(max-width: 760px) calc((100vw - 70px) / 2), (max-width: 1100px) calc((100vw - 360px) / 2), (max-width: 1320px) calc((100vw - 410px) / 3), 303.33px"
                  alt={`${item.title} 官方视觉缩略图`}
                  loading="lazy"
                  width="900"
                  height="506"
                />
              </picture>
              <div>
                <h3>{item.title}</h3>
                <p>{item.subtitle}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section" aria-labelledby="now-doing-title">
        <div class="about-section-heading">
          <Icon name="tabler:flower" aria-hidden="true" />
          <div>
            <p>Light activity</p>
            <h2 id="now-doing-title">最近的电波</h2>
          </div>
        </div>

        <div class="about-activity-grid">
          {nowDoing.map((item) => (
            <article>
              <span>{item.label}</span>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>
    </section>
  </section>

  <style>
    .about-profile-shell {
      margin: 0 auto;
      display: grid;
      align-items: start;
    }

    .about-sidebar {
      position: sticky;
      display: grid;
    }

    .about-avatar-card,
.about-id-card,
.about-status-card,
.about-readme-hero,
.about-section {
      position: relative;
      isolation: isolate;
      overflow: visible;
    }

    .about-avatar-card {
      display: grid;
      place-items: center;
      min-height: 250px;
    }

    .about-avatar-card img {
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 50%;
    }

    .about-kicker,
.about-mini-title,
.about-section-heading p {
      margin: 0;
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      font-weight: 800;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .about-id-card h1,
    .about-readme-hero h2,
    .about-section-heading h2 {
      margin: 6px 0 0;
      color: var(--ink);
      letter-spacing: 0;
    }

    .about-handle {
      margin: 8px 0 0;
    }

    .about-bio,
    .about-readme-hero p,
    .about-activity-grid p {
      color: var(--ink-soft);
      line-height: 1.85;
    }

    .about-link-row {
      display: flex;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    .about-link-row a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--ink);
      font-weight: 800;
      text-decoration: none;
      border: 1px solid rgba(93, 113, 145, 0.18);
    }

    .about-link-row svg,
    .about-section-heading svg,
    .about-tech-icon svg {
      width: 1.2em;
      height: 1.2em;
    }

    .about-status-card ul {
      display: grid;
      gap: 10px;
      padding: 0;
      margin: 14px 0 0;
      list-style: none;
    }

    .about-status-card li {
      display: grid;
      grid-template-columns: 20px minmax(0, 1fr);
      gap: 8px;
      align-items: start;
      color: var(--ink);
      font-size: 0.94rem;
      font-weight: 700;
      line-height: 1.55;
    }

    .about-status-card svg {
      width: 18px;
      height: 18px;
      margin-top: 2px;
      color: var(--pink);
    }

    .about-readme {
      display: grid;
    }

    .about-readme-hero {
      display: grid;
      align-items: center;
    }

    .about-readme-badge {
      display: grid;
      place-items: center;
      align-content: center;
      color: var(--ink);
      text-align: center;
    }

    .about-readme-badge span {
      margin-top: 8px;
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      font-weight: 800;
      line-height: 1.3;
    }

    .about-section {
      display: grid;
    }

    .about-section-heading {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .about-section-heading > svg {
      flex: 0 0 auto;
      width: 38px;
      height: 38px;
      padding: 8px;
      border-radius: 8px;
    }

    .about-tech-grid {
      display: grid;
    }

    .about-tech-card {
      display: grid;
      color: var(--ink);
      border-radius: 8px;
    }

    .about-tech-icon {
      display: grid;
      place-items: center;
      background: var(--blue-soft);
    }

    .about-tech-card--orange .about-tech-icon {
      color: #e2762d;
      background: #ffe8cf;
    }

    .about-tech-card--ink .about-tech-icon {
      color: #fffaf1;
      background: #31425f;
    }

    .about-tech-card--pink .about-tech-icon {
      color: #c85278;
      background: var(--pink-soft);
    }

    .about-tech-card--mint .about-tech-icon {
      color: #3c8067;
      background: rgba(184, 219, 201, 0.58);
    }

    .about-tech-card h3,
    .about-media-card h3 {
      margin: 0;
      color: var(--ink);
      font-size: 1rem;
      line-height: 1.35;
    }

    .about-media-card h3 {
      font-size: 0.96rem;
    }

    .about-tech-card p,
    .about-media-card p {
      margin: 5px 0 0;
      color: var(--ink-soft);
      font-size: 0.82rem;
      line-height: 1.45;
    }

    .about-media-grid {
      display: grid;
    }

    .about-media-card {
      overflow: hidden;
      border-radius: 8px;
    }

    .about-media-card img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }

    .about-media-card img {
      height: auto;
      object-fit: contain;
    }

    .about-media-card div {
      padding: 12px;
    }

    .about-media-card div {
      min-height: 72px;
      padding: 10px 12px 12px;
    }

    .about-activity-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about-activity-grid article {
      min-height: 132px;
    }

    .about-activity-grid span {
      display: inline-flex;
      padding: 5px 10px;
      color: var(--ink);
      font-size: 0.78rem;
      font-weight: 800;
      background: var(--pink-soft);
      border-radius: 999px;
    }

    @media (max-width: 1080px) {

      .about-sidebar {
        position: static;
        grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1fr);
        align-items: stretch;
      }

      .about-status-card {
        grid-column: 1 / -1;
      }

      .about-status-card ul {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 760px) {

      .about-sidebar,
.about-status-card ul,
.about-activity-grid {
        grid-template-columns: 1fr;
      }

      .about-readme-badge {
        justify-self: start;
      }

      .about-readme-hero h2 {
        overflow-wrap: anywhere;
      }
    }

    @media (max-width: 520px) {

      .about-media-card {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
