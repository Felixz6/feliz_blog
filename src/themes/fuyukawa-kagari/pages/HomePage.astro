---
import BaseLayout from "../layouts/BaseLayout.astro";
import { kagariAssets } from "../assets";
import { Icon } from "astro-icon/components";
import { getPublishedPosts } from "@/core/content/blog";
import { getCoverSources } from "@/core/content/coverSources";
import { profileIdentity } from "@/core/data/profile";
import { site } from "@/lib/site";
import LayeredHero from "../components/LayeredHero.astro";
import ChapterRail from "../components/ChapterRail.astro";
import MangaArt from "../components/MangaArt.astro";
import HomeHeroRuntime from "../components/HomeHeroRuntime.astro";

const recentPosts = (await getPublishedPosts()).slice(0, 3);

const fallingTags: string[] = [];
const initialRenderTime = new Date();
const initialHomeDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  weekday: "long"
}).format(initialRenderTime);
const initialHomeTime = new Intl.DateTimeFormat("zh-CN", {
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false
}).format(initialRenderTime);
---

<BaseLayout needsMangaRuntime>
  <section class="hero-stage" data-hero-stage>
    <div class="hero">
      <LayeredHero />
      <div class="hero-overlay"></div>
      <div class="hero-copy" data-hero-copy>
        <p class="eyebrow">Fuyukawa Kagari · Personal diary</p>
        <h1 data-title={site.name}>{site.name}</h1>
        <p class="hero-diary-line">把喜欢的事，写进每一个平凡日子。</p>
        <p class="hero-text terminal-line">
          <span class="hero-terminal-badge" aria-hidden="true"></span>
          <span class="hero-terminal-stack">
            <span class="hero-terminal-status" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
            <span class="hero-terminal-command">
              <span class="terminal-prefix"><Icon name="tabler:flower" aria-hidden="true" /></span>
              <span class="terminal-typing" data-terminal-typing></span>
            </span>
          </span>
          <span class="terminal-cursor" aria-hidden="true"></span>
        </p>
      </div>

      <div class="hero-profile identity-card" data-hero-profile role="group" aria-label="Profile">
        <div class="identity-avatar" data-poke-avatar>
          <img src={kagariAssets.profile} alt={`${profileIdentity.displayName} avatar`} width="168" height="168" />
          <span class="avatar-poke-bubble" data-poke-bubble>&#x64CD;&#x4F5C;&#x592A;&#x5FEB;&#x5566;&#xFF0C;&#x4F11;&#x606F;&#x4E00;&#x4E0B;&#x5427;</span>
        </div>
        <div class="identity-terminal" role="group" aria-label="identity terminal card">
          <div class="identity-terminal-bar">
            <div class="terminal-dots" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span class="terminal-title">profile.exe</span>
          </div>
          <p class="identity-path">~/profile</p>
          <p class="identity-command">
            <span class="terminal-prefix">user@blog:~$</span>
            <span data-name-typing data-name-lines={JSON.stringify([profileIdentity.displayName, profileIdentity.handle])}></span>
            <span class="terminal-cursor" aria-hidden="true"></span>
          </p>
          <p class="identity-caption">{profileIdentity.displayName} / {profileIdentity.handle}</p>
          <nav class="social-links" aria-label="Social links">
            {profileIdentity.github.startsWith("https://") && <a href={profileIdentity.github} target="_blank" rel="noreferrer" aria-label="GitHub profile">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.1 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56v-2.16c-3.2.7-3.87-1.38-3.87-1.38-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 5.98c.98 0 1.96.13 2.88.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.24 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.41-5.27 5.7.41.36.77 1.06.77 2.14v3.18c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
              </svg>
              GitHub
            </a>}
            {profileIdentity.bilibili.startsWith("https://") && <a href={profileIdentity.bilibili} target="_blank" rel="noreferrer" aria-label="Bilibili profile">
              <svg viewBox="0 0 32 32" aria-hidden="true">
                <path d="M11.1 6.4 8.5 3.8a1.4 1.4 0 0 0-2 2l2.7 2.7h-.7A5.5 5.5 0 0 0 3 14v7.2A5.5 5.5 0 0 0 8.5 26h15A5.5 5.5 0 0 0 29 21.2V14a5.5 5.5 0 0 0-5.5-5.5h-.7l2.7-2.7a1.4 1.4 0 0 0-2-2l-2.6 2.6H11.1Zm-2.6 5h15A2.6 2.6 0 0 1 26.1 14v7.2a2.6 2.6 0 0 1-2.6 2.6h-15a2.6 2.6 0 0 1-2.6-2.6V14a2.6 2.6 0 0 1 2.6-2.6Zm2.7 5.1a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2Zm9.6 0a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2Z" />
              </svg>
              Bilibili
            </a>}
          </nav>
        </div>
      </div>

      <a class="scroll-cue" href="#main-content" aria-label="Scroll to content">
        <span class="scroll-cue__prompt">翻开下一页</span>
        <span class="scroll-cue__arrows" aria-hidden="true">
          <span>&gt;</span>
          <span>&gt;</span>
          <span>&gt;</span>
        </span>
      </a>
    </div>
  </section>

  <div class="scene-divider" aria-hidden="true">
    <div class="scene-divider__rail">
      <span class="scene-divider__glow"></span>
      <span class="scene-divider__stitch"></span>
      <span class="scene-divider__note note-a"></span>
      <span class="scene-divider__note note-b"></span>
      <span class="scene-divider__note note-c"></span>
      <span class="scene-divider__spark spark-a"></span>
      <span class="scene-divider__spark spark-b"></span>
      <span class="scene-divider__spark spark-c"></span>
    </div>
  </div>

  <ChapterRail />

  <div class="home-content-bg">
    <img class="home-content-bg__image" src={kagariAssets.pageBackground} alt="" width="1920" height="1360" loading="lazy" decoding="async" fetchpriority="low" />
    <section class="tag-rain-stage" id="main-content" data-tag-rain data-tags={JSON.stringify(fallingTags)} aria-label="Blog topic tags">
      <div class="home-art-word">
        <span>{site.name}</span>
        <small>anime notes / tiny toys / dev memo</small>
      </div>
      <div class="home-signal-card" role="group" aria-label="Local signal">
        <p data-home-date>{initialHomeDate}</p>
        <strong data-home-time>{initialHomeTime}</strong>
      </div>
      <div class="home-welcome-bubble">
        <span aria-hidden="true">“</span>
        <strong>哇，你终于回来了～</strong>
        <p>喜欢的故事、偶然的灵感，还有今天想分享的小事。</p>
        <span aria-hidden="true">”</span>
      </div>
      <canvas class="tag-rain-canvas" data-tag-rain-canvas aria-hidden="true"></canvas>
    </section>
  </div>

  <section class="home-journal" aria-labelledby="home-journal-title">
    <header class="journal-heading">
      <div>
        <p class="section-kicker">From my notebook</p>
        <h2 id="home-journal-title">最近写下的事</h2>
      </div>
      <a href="/blog/">全部笔记 <Icon name="tabler:arrow-right" aria-hidden="true" /></a>
    </header>
    <div class="journal-margin-note" aria-hidden="true"><MangaArt image="kagari-tea" /><span>今天，也有想记住的事。</span></div>
    <div class="journal-grid">
      {recentPosts.map((post) => (
        <a class="journal-entry" href={`/blog/${post.id}/`}>
          <img src={post.data.cover ?? kagariAssets.heroWallpaper} {...getCoverSources(post.data.cover, "(max-width: 480px) calc(100vw - 48px), (max-width: 760px) 180px, 380px")} alt="" width="700" height="1000" loading="lazy" decoding="async" />
          <div>
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("zh-CN")}</time>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
          <Icon name="tabler:arrow-up" class="journal-arrow" aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>


  <script>
    import { mountHomeRuntime } from "../lib/home-runtime.mjs";

    let cleanup = () => {};
    const start = () => { cleanup = mountHomeRuntime(); };
    const dispose = () => { cleanup(); };
    document.addEventListener("astro:page-load", start);
    document.addEventListener("astro:before-swap", dispose);
    start();
  </script>

  <HomeHeroRuntime />
</BaseLayout>
