---
import themeHref from "../styles/theme.css?url";
import refreshHref from "../styles/refresh.css?url";
import mangaHref from "../styles/manga.css?url";
import refreshPagesHref from "../styles/refresh-pages.css?url";
import mangaPagesHref from "../styles/manga-pages.css?url";
import { site } from "@/lib/site";
import type { BlogPost } from "@/core/content/blog";
import { Icon } from "astro-icon/components";
import { ClientRouter } from "astro:transitions";
import ThemeLongPressMenu from "@/core/themes/ThemeLongPressMenu.astro";
import ConsoleEasterEgg from "@/core/ConsoleEasterEgg.astro";
import PerformanceProfile from "@/core/PerformanceProfile.astro";
import SeoMeta from "@/core/SeoMeta.astro";
import { getCanonicalPath } from "@/core/themes/registry";
import { mangaArt } from "../data/mangaArt";
import { kagariAssets } from "../assets";
import MangaRuntime from "../components/MangaRuntime.astro";
import SakuraRain from "../components/SakuraRain.astro";

interface Props {
  title?: string;
  description?: string;
  redirectThemedNotFound?: boolean;
  isArticlePage?: boolean;
  needsMangaRuntime?: boolean;
  article?: BlogPost["data"];
}

const {
  title = site.title,
  description = site.description,
  redirectThemedNotFound = false,
  isArticlePage = false,
  needsMangaRuntime = false,
  article
} = Astro.props;
const canonicalPath = getCanonicalPath(Astro.url.pathname);
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url);
// Bypass the stale CDN 404 entries cached during the shared-CSS rollout.
const sharedStylesheetVersion = "20260928-blog-search-toc";
const themeHomePath = "/";
const heroCharacter = mangaArt("hero-character");
const heroManga = mangaArt("hero-manga");
const navItems = site.nav.map((item) => ({
  ...item,
  tone: ["/blog/", "/about/"].includes(item.href) ? "pink" : "blue"
}));
const voyagerOneStart = new Date("1977-09-05T12:56:00Z");
const voyagerTwoStart = new Date("1977-08-20T14:29:00Z");
const contractStart = new Date("2022-09-24T00:00:00+08:00");
const initialRenderTime = new Date();
const formatInitialElapsed = (start: Date, mode: "minute" | "days") => {
  const totalSeconds = Math.floor(Math.max(0, initialRenderTime.getTime() - start.getTime()) / 1000);
  const days = Math.floor(totalSeconds / 86400);
  if (mode === "days") return `第 ${days.toLocaleString("zh-CN")} 天`;
  const hours = Math.floor((totalSeconds % 86400) / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  return `${days.toLocaleString("zh-CN")}天 ${String(hours).padStart(2, "0")}小时 ${String(minutes).padStart(2, "0")}分`;
};
const isAlternateThemeRoute = Astro.url.pathname.startsWith("/themes/");
const themedNotFoundRedirectScript = `(() => {
  const themePrefix = "/themes/fuyukawa-kagari";
  if (window.location.pathname !== themePrefix && !window.location.pathname.startsWith(themePrefix + "/")) return;
  const notFoundPath = themePrefix + "/404/";
  if (window.location.pathname === notFoundPath) return;
  const original = window.location.pathname + window.location.search + window.location.hash;
  window.location.replace(notFoundPath + "?from=" + encodeURIComponent(original));
})();`;
---

<!doctype html>
<html lang="zh-CN" data-theme="fuyukawa-kagari" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PerformanceProfile />
    <SeoMeta title={title} description={description} canonical={canonical} isArticlePage={isArticlePage} article={article} />
    <meta name="theme-color" content="#f6fbfa" />
    {isAlternateThemeRoute && <meta name="robots" content="noindex,follow" />}
    {
      redirectThemedNotFound && (
        <script is:inline set:html={themedNotFoundRedirectScript}></script>
      )
    }
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={kagariAssets.favicon} />
    <link rel="apple-touch-icon" href={kagariAssets.appleTouchIcon} />
    <title>{title}</title>
    {Astro.url.pathname === "/" && (
      <>
        <link
          rel="preload"
          as="image"
          href={kagariAssets.mobileHeroManga}
          type="image/webp"
          media="(max-width: 760px) and (orientation: portrait) and (max-aspect-ratio: 3/5)"
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          href={heroCharacter.src}
          type="image/webp"
          media="(min-width: 761px)"
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          href={heroManga.src}
          type="image/webp"
          media="(min-width: 761px)"
          fetchpriority="high"
        />
      </>
    )}
    <!-- Shared URLs avoid stale dev inline CSS replacing current styles during page swaps. -->
    <link rel="stylesheet" href={`${themeHref}?v=${sharedStylesheetVersion}`} />
    <link rel="stylesheet" href={`${refreshHref}?v=${sharedStylesheetVersion}`} />
    <link rel="stylesheet" href={`${mangaHref}?v=${sharedStylesheetVersion}`} />
    {canonicalPath !== "/" && <link rel="stylesheet" href={refreshPagesHref} />}
    {canonicalPath !== "/" && <link rel="stylesheet" href={mangaPagesHref} />}
    <ClientRouter />
    <ConsoleEasterEgg />
  </head>
  <body
    data-fuyukawa
    data-pagefind-ignore={isAlternateThemeRoute ? true : undefined}
    data-yuimi-article-page={isArticlePage ? "true" : undefined}
  >
    <a class="skip-to-content" href="#page-content">跳至正文</a>
    <SakuraRain />
    <div class="scroll-progress" data-scroll-progress aria-hidden="true">
      <div class="scroll-progress-track">
        <div class="scroll-progress-fill"></div>
      </div>
    </div>
    <aside class="toy-dock" aria-label="Music controls" transition:persist="yuimi-toy-dock">
      <button class="toy-dock-handle" type="button" aria-label="打开音乐工具" title="音乐播放器" aria-expanded="false" aria-controls="toy-dock-panel">
        <Icon name="tabler:player-play" aria-hidden="true" />
      </button>
      <div class="toy-dock-panel" id="toy-dock-panel">
        <section class="toy-widget music-widget" aria-label="音乐播放器">
          <div class="toy-widget-title">
            <span>♫</span>
            <strong>Music</strong>
          </div>
          <div class="music-player-shell">
            <div class="music-cover-area">
              <div class="record-player" aria-hidden="true">
                <div class="record-arm"></div>
                <div class="record-disc">
                  <div class="record-label">
                    <span aria-hidden="true">♫</span>
                  </div>
                </div>
              </div>
              <span class="music-cover-caption" data-music-status>已暂停</span>
            </div>
            <div class="music-info-area">
              <span class="music-meta">Playlist</span>
              <p class="music-track">高橋優 - ヤキモチ</p>
              <p class="music-note" data-music-note>点击播放即可聆听</p>
            </div>
          </div>
          <div class="music-progress">
            <div class="music-control-label">
              <span>播放进度</span>
              <strong><span data-music-current>00:00</span> / <span data-music-duration>00:00</span></strong>
            </div>
            <input data-music-seek type="range" min="0" max="100" value="0" step="0.1" aria-label="播放进度" />
          </div>
          <div class="music-bottom-row">
            <div class="music-controls" role="group" aria-label="播放控制">
              <button type="button" data-music-prev aria-label="上一首" title="上一首"><Icon name="tabler:player-skip-forward" aria-hidden="true" /></button>
              <button type="button" data-music-toggle aria-label="播放音乐" title="播放音乐" aria-pressed="false">
                <Icon class="music-play-icon" name="tabler:player-play" aria-hidden="true" />
                <Icon class="music-pause-icon" name="tabler:player-pause" aria-hidden="true" />
              </button>
              <button type="button" data-music-next aria-label="下一首" title="下一首"><Icon name="tabler:player-skip-forward" aria-hidden="true" /></button>
            </div>
            <div class="music-volume">
              <div class="music-control-label">
                <span>音量</span>
                <strong data-music-volume-label>28%</strong>
              </div>
              <input data-music-volume type="range" min="0" max="1" value="0.28" step="0.01" aria-label="音量" />
            </div>
          </div>
        </section>

      </div>
    </aside>
    <nav class="custom-context-menu" data-context-menu aria-label="&#x5FEB;&#x6377;&#x83DC;&#x5355;">
      <button type="button" data-context-action="top">&#x2191; &#x56DE;&#x5230;&#x9876;&#x90E8;</button>
      <button type="button" data-context-action="refresh">&#x21BB; &#x5237;&#x65B0;&#x9875;&#x9762;</button>
      <button type="button" data-context-action="home">&#x2302; &#x8FD4;&#x56DE;&#x9996;&#x9875;</button>
      <button type="button" data-context-action="back">&#x2190; &#x540E;&#x9000;</button>
      <button type="button" data-context-action="forward">&#x2192; &#x524D;&#x8FDB;</button>
      <button type="button" data-context-action="copy">&#x29C9; &#x590D;&#x5236;&#x94FE;&#x63A5;</button>
      <button type="button" data-context-action="title">T &#x590D;&#x5236;&#x6807;&#x9898;</button>
      <button type="button" data-context-action="sakura" aria-pressed="true">&#x273F; 樱花雨：开</button>
      <button type="button" data-context-action="music-autoplay" aria-pressed="false">♫ 进站续播：关</button>
    </nav>
    <div class="site-shell">
      <header class="site-header" aria-label="Primary">
        <a class="brand" href={themeHomePath} aria-label={`${site.name} home`}>
          <span>{site.name}</span>
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          {
            navItems.map((item) => (
              <a href={item.href} data-navigation-tone={item.tone} data-astro-prefetch="hover" aria-label={`${item.label}: ${item.hint}`} aria-current={(item.href === themeHomePath ? Astro.url.pathname === item.href : Astro.url.pathname.startsWith(item.href)) ? "page" : undefined}>
                <span class="nav-icon" aria-hidden="true"><Icon name={item.icon} /></span>
                <span class="nav-label">{item.label}</span>
                <span class="nav-hint">{item.hint}</span>
              </a>
            ))
          }
          <span class="navigation-bookmark" data-navigation-bookmark role="status" aria-live="polite" aria-atomic="true" lang="ja">
            <svg class="navigation-book" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 7C9 5 5 5 2 6v13c3-1 7-1 10 1 3-2 7-2 10-1V6c-3-1-7-1-10 1Z" fill="var(--paper)" />
              <path d="M12 7v13" />
              <path class="navigation-book-page" d="M12 7c3-2 7-2 10-1v13c-3-1-7-1-10 1Z" />
              <path class="navigation-book-page navigation-book-page--second" d="M12 7c3-2 7-2 10-1v13c-3-1-7-1-10 1Z" />
            </svg>
            <span data-navigation-message></span>
          </span>
        </nav>
      </header>
      <main id="page-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer" data-footer-timers>
        <div class="footer-inner">
          <p class="footer-signature-line">© 2026 {site.author} / {site.name}</p>
          <p>二次元手账、开发记录、还有一点点宇宙回声。</p>
          <p>🛰️ 旅行者一号：<time data-elapsed-from="1977-09-05T12:56:00Z" data-elapsed-mode="minute" dateTime={voyagerOneStart.toISOString()}>{formatInitialElapsed(voyagerOneStart, "minute")}</time> 仍在远航</p>
          <p>🛰️ 旅行者二号：<time data-elapsed-from="1977-08-20T14:29:00Z" data-elapsed-mode="minute" dateTime={voyagerTwoStart.toISOString()}>{formatInitialElapsed(voyagerTwoStart, "minute")}</time> 仍在远航</p>
          <p>💍 契约之吻：<time data-elapsed-from="2022-09-24T00:00:00+08:00" data-elapsed-mode="days" dateTime={contractStart.toISOString()}>{formatInitialElapsed(contractStart, "days")}</time>，第二季仍未响应</p>
          <p class="footer-status-line">sakura: falling / music: ready / tea: warm</p>
          <p class="manga-art-credit">插画与漫画：葉佐乃《儚いキミは猛攻をはじめる》 · 冬川篝主题手帖</p>
        </div>
      </footer>
    </div>
    <ThemeLongPressMenu />
    {needsMangaRuntime && <MangaRuntime />}

    <script>
      import { installLayoutRuntime } from "../lib/layout-runtime.mjs";

      installLayoutRuntime({ endpoint: import.meta.env.PUBLIC_WEB_VITALS_ENDPOINT ?? "" });
    </script>
  </body>
</html>
