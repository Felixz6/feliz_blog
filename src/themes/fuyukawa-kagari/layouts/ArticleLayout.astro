---
import type { MarkdownHeading } from "astro";
import type { ArticleData } from "@/core/content/blog";
import BaseLayout from "./BaseLayout.astro";
import { categoryLabel } from "@/lib/site";
import { getCanonicalPath } from "@/core/themes/registry";
import { Icon } from "astro-icon/components";
import MangaArt from "../components/MangaArt.astro";
import ArticleMobileToc from "../components/ArticleMobileToc.astro";
import ArticleTocLinks from "../components/ArticleTocLinks.astro";
import { site } from "@/lib/site";

interface Props {
  frontmatter: ArticleData;
  headings?: MarkdownHeading[];
  archiveHref?: string;
  archiveLabel?: string;
  footerLabel?: string;
}

const { frontmatter, archiveHref, archiveLabel, footerLabel } = Astro.props;
const returnHref = archiveHref ?? "/blog/";
const returnLabel = archiveLabel ?? "回到笔记存档";
const footerActionLabel = footerLabel ?? "再翻一篇笔记";
const title = `${frontmatter.seoTitle ?? frontmatter.title} | ${site.name}`;
const description = frontmatter.seoDescription ?? frontmatter.description;
const date = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
}).format(frontmatter.pubDate);
const articleUrl = new URL(getCanonicalPath(Astro.url.pathname), Astro.site ?? Astro.url).href;
const headings = (Astro.props.headings ?? []).filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const shouldIndexArticle = getCanonicalPath(Astro.url.pathname) === Astro.url.pathname;
---

<BaseLayout title={title} description={description} isArticlePage article={frontmatter} needsMangaRuntime>
  <div class="article-shell" data-article-shell>
    <ArticleMobileToc headings={headings} />
    <article class="article" data-pagefind-body={shouldIndexArticle ? true : undefined}>
      <a class="back-link" href={returnHref}><Icon name="tabler:arrow-left" aria-hidden="true" />{returnLabel}</a>
      <header class="article-header">
        <div class="meta-row">
          <a class="blog-category-filter-link" href={`/blog/?category=${encodeURIComponent(frontmatter.category)}`}>{categoryLabel[frontmatter.category]}</a>
          <time datetime={frontmatter.pubDate.toISOString()}>{date}</time>
        </div>
        <h1>{frontmatter.title}</h1>
        <p>{frontmatter.description}</p>
        <div class="tag-row" role="group" aria-label="Tags">
          {frontmatter.tags.map((tag: string) => <a class="blog-tag-link" href={`/blog/?q=${encodeURIComponent(tag)}`}>#{tag}</a>)}
        </div>
        <div class="article-print-meta" aria-label="打印信息">
          <span>作者：{site.author}</span>
          <time datetime={frontmatter.pubDate.toISOString()}>日期：{date}</time>
          <span>文章地址：<a href={articleUrl}>{articleUrl}</a></span>
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer class="article-colophon" data-pagefind-ignore>
        <MangaArt image="hand-note" />
        <div><span class="manga-handwritten">To be continued.</span><p>这一页，先写到这里。</p><a href={returnHref}>{footerActionLabel} <Icon name="tabler:arrow-right" aria-hidden="true" /></a></div>
      </footer>
    </article>
    {
      tocHeadings.length > 0 && (
        <aside class="article-toc" aria-label="文章导航" data-pagefind-ignore>
          <p>这篇笔记的目录</p>
          <ArticleTocLinks headings={tocHeadings} ariaLabel="桌面端文章导航" />
          <MangaArt image="kagari-thinking" class="article-margin-character" />
        </aside>
      )
    }
    <dialog class="article-image-viewer" data-article-image-viewer aria-labelledby="article-image-viewer-title">
      <div class="article-image-viewer-panel">
        <header class="article-image-viewer-header">
          <h2 id="article-image-viewer-title">图片查看</h2>
          <button type="button" data-image-viewer-close aria-label="关闭图片查看器" title="关闭（Esc）">
            <Icon name="tabler:x" aria-hidden="true" />
          </button>
        </header>
        <div class="article-image-viewer-stage" data-image-viewer-stage tabindex="0" aria-label="图片预览；滚轮缩放，方向键移动">
          <img data-image-viewer-image alt="" draggable="false" />
        </div>
        <p class="article-image-viewer-caption" data-image-viewer-caption></p>
        <footer class="article-image-viewer-footer">
          <div class="article-image-viewer-controls" role="group" aria-label="图片缩放控制">
            <button type="button" data-image-viewer-zoom="out" aria-label="缩小" title="缩小（−）"><Icon name="tabler:zoom-out" aria-hidden="true" /></button>
            <output data-image-viewer-zoom-level aria-live="polite">100%</output>
            <button type="button" data-image-viewer-zoom="in" aria-label="放大" title="放大（+）"><Icon name="tabler:zoom-in" aria-hidden="true" /></button>
            <button type="button" data-image-viewer-zoom="reset" aria-label="适应窗口" title="适应窗口（0）">适应窗口</button>
          </div>
          <a data-image-viewer-original target="_blank" rel="noopener noreferrer">查看原图 <Icon name="tabler:external-link" aria-hidden="true" /></a>
        </footer>
        <p class="article-image-viewer-help">Esc 关闭 · + / − 缩放 · 0 适应窗口 · 方向键移动</p>
      </div>
    </dialog>
  </div>
</BaseLayout>
